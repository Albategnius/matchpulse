# Copy to .env for local use. NEVER commit .env. No secrets are needed for the default demo.

# Optional: Microsoft Foundry model for the Narrative & Personalization Agent.
# Leave empty to run in local deterministic-template mode.
# Project endpoint format: https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
# The model DEPLOYMENT name in your Foundry project (e.g. gpt-4.1-mini)
FOUNDRY_MODEL=

# Authentication uses Microsoft Entra ID via DefaultAzureCredential:
#  - locally: run `az login` first
#  - in Azure Container Apps: a managed identity with the "Azure AI User" role on the Foundry project
# No API key is used or required.

# auto | off   (off forces local templates even if Foundry is configured)
MATCHPULSE_LLM=auto
MATCHPULSE_LLM_TIMEOUT=25
MATCHPULSE_WORKFLOW_TIMEOUT=90
LOG_LEVEL=INFO
